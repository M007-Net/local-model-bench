# Optional stable panel password; when empty, Docker logs print a generated one.
LMB_WEB_TOKEN=
LMB_PORT=8080
# Set to a LAN/Tailscale address to allow access from another machine.
LMB_BIND_ADDRESS=127.0.0.1
# Comma-separated custom DNS names, if used to reach the panel.
LMB_ALLOWED_HOSTS=
# Optional persistent volume name for this deployment.
LMB_VOLUME_NAME=local-model-bench-data
