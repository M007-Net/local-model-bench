{
  "name": "local-model-bench",
  "version": "1.16.0",
  "description": "Private desktop benchmarks and transparent grading for LM Studio models",
  "author": "Local Model Bench contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M007-Net/local-model-bench"
  },
  "homepage": "https://github.com/M007-Net/local-model-bench#readme",
  "bugs": {
    "url": "https://github.com/M007-Net/local-model-bench/issues"
  },
  "private": true,
  "keywords": [
    "lm-studio",
    "benchmark",
    "llm",
    "electron",
    "windows",
    "local-ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs && node scripts/licenses.mjs",
    "test": "tsx --test tests/*.test.ts",
    "gpu:check": "tsx scripts/gpu-check.ts",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --win nsis --x64 && node scripts/checksums.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:agents": "node scripts/qa-agents.mjs",
    "qa:agents:packaged": "node scripts/qa-agents-packaged.mjs",
    "agents:calibrate": "tsx scripts/agent-calibrate.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "local.model.bench",
    "productName": "Local Model Bench",
    "directories": {
      "output": "outputs"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Local-Model-Bench-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
